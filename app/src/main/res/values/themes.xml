<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Framework (non-AppCompat) theme to avoid any compat-resource crash. -->
    <style name="Theme.LiquidPrank" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Bright fallback: if drawing ever fails, the window is still visibly coloured,
             never a black "nothing happened" screen. -->
        <item name="android:windowBackground">@android:color/holo_purple</item>
    </style>

    <style name="Theme.LiquidPrank.Fullscreen" parent="Theme.LiquidPrank">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
