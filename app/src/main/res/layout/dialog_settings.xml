<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="菜单"
            android:textColor="@color/fg"
            android:textSize="20sp" />

        <!-- 地图 -->
        <TextView
            style="@style/Menu.Section"
            android:text="地图" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swLabels"
            style="@style/Menu.Switch"
            android:text="显示地名" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/groupTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button android:id="@+id/tAuto" style="@style/Menu.Toggle" android:text="自动" />
            <Button android:id="@+id/tDay" style="@style/Menu.Toggle" android:text="浅色" />
            <Button android:id="@+id/tNight" style="@style/Menu.Toggle" android:text="深色" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 导航 -->
        <TextView
            style="@style/Menu.Section"
            android:text="导航" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swVoice"
            style="@style/Menu.Switch"
            android:text="语音播报" />

        <!-- 足迹 -->
        <TextView
            style="@style/Menu.Section"
            android:text="足迹" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swBackground"
            style="@style/Menu.Switch"
            android:text="锁屏后继续记录" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swTrack"
            style="@style/Menu.Switch"
            android:text="在地图上显示足迹" />

        <TextView
            android:id="@+id/tvTrack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnClearTrack"
            style="@style/Menu.Action"
            android:layout_marginTop="10dp"
            android:text="清除所有足迹" />

        <!-- 离线地图 -->
        <TextView
            style="@style/Menu.Section"
            android:text="离线地图" />

        <TextView
            android:id="@+id/tvOffline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOfflineDownload"
            style="@style/Menu.Action"
            android:layout_marginTop="10dp"
            android:text="选择范围下载离线地图" />

        <Button
            android:id="@+id/btnOfflineDelete"
            style="@style/Menu.Action"
            android:text="删除离线地图"
            android:visibility="gone" />

        <!-- 音乐 -->
        <TextView
            style="@style/Menu.Section"
            android:text="音乐" />

        <Button
            android:id="@+id/btnMusicAccess"
            style="@style/Menu.Action"
            android:text="开启歌名显示" />

        <!-- 其它 -->
        <TextView
            style="@style/Menu.Section"
            android:text="其它" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swImperial"
            style="@style/Menu.Switch"
            android:text="英制单位（mph）" />

        <Button
            android:id="@+id/btnDemo"
            style="@style/Menu.Action"
            android:text="演示模式" />

        <Button
            android:id="@+id/btnResetTrip"
            style="@style/Menu.Action"
            android:text="清零本次骑行" />

        <TextView
            android:id="@+id/tvOdo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
