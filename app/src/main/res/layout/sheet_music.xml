<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮播放器：跳动音乐柱、歌名歌手、进度条、播放控制 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <com.ebike.dash.EqualizerView
        android:id="@+id/eq"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:importantForAccessibility="no"
        android:tag="15" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/fg"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/fg_dim"
        android:textSize="15sp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:valueFrom="0"
        android:valueTo="1"
        app:haloRadius="0dp"
        app:labelBehavior="gone"
        app:thumbColor="@color/fg"
        app:thumbHeight="14dp"
        app:thumbTrackGapSize="0dp"
        app:thumbWidth="14dp"
        app:trackStopIndicatorSize="0dp"
        app:trackColorActive="@color/fg"
        app:trackColorInactive="@color/chip"
        app:trackHeight="4dp" />

    <LinearLayout
        android:id="@+id/timeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:id="@+id/tvPos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/fg_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/bg"
            android:contentDescription="上一首"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_prev"
            app:tint="@color/fg" />

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="28dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/fg"
            android:contentDescription="播放 / 暂停"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/bg" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/bg"
            android:contentDescription="下一首"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next"
            app:tint="@color/fg" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/fg_dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnOpenApp"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="打开 Apple Music"
        android:textColor="@color/fg"
        android:textSize="14sp" />
</LinearLayout>
