<?xml version="1.0" encoding="utf-8"?>
<!-- 离线地图下载进度：与确认提示同一种悬浮卡片，进度条复用速度能量条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="正在下载离线地图"
        android:textColor="@color/fg"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/fg_dim"
        android:textSize="15sp" />

    <com.ebike.dash.EnergyBarView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="22dp" />

    <TextView
        android:id="@+id/tvPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/fg_dim"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNegative"
            style="@style/PillButton"
            android:layout_marginEnd="10dp"
            android:backgroundTint="@color/chip"
            android:text="取消下载"
            android:textColor="@color/fg" />

        <TextView
            android:id="@+id/btnPositive"
            style="@style/PillButton"
            android:backgroundTint="@color/fg"
            android:text="后台下载"
            android:textColor="@color/bg" />
    </LinearLayout>
</LinearLayout>
