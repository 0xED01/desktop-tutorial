<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/scrim_top" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <!-- 顶部：状态栏 + 导航转向提示 -->
        <LinearLayout
            android:id="@+id/topArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/statusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <View
                    android:id="@+id/gpsDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="#FF3D57" />

                <TextView
                    android:id="@+id/tvGps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="GPS 搜索中"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:fontFeatureSettings="tnum"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <com.ebike.dash.TurnArrowView
                    android:id="@+id/turnArrow"
                    android:layout_width="58dp"
                    android:layout_height="58dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTurnDist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/accent"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTurnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧功能按钮 -->
        <LinearLayout
            android:id="@+id/fabColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageButton android:id="@+id/btnSearch" style="@style/GlassButton" android:src="@drawable/ic_search" android:contentDescription="搜索目的地" />
            <ImageButton android:id="@+id/btnRecenter" style="@style/GlassButton" android:src="@drawable/ic_my_location" android:contentDescription="回到当前位置" />
            <ImageButton android:id="@+id/btnTheme" style="@style/GlassButton" android:src="@drawable/ic_moon" android:contentDescription="日夜模式" />
            <ImageButton android:id="@+id/btnSettings" style="@style/GlassButton" android:src="@drawable/ic_settings" android:contentDescription="设置" />
        </LinearLayout>

        <!-- 底部：导航信息 + 透明码表 + 骑行数据 -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/navInfo"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvRemain" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvEtaMin" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用时" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvEta" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="到达" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnStopNav"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_danger_circle"
                    android:contentDescription="结束导航"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <com.ebike.dash.SpeedometerView
                android:id="@+id/gauge"
                android:layout_width="272dp"
                android:layout_height="272dp" />

            <LinearLayout
                android:id="@+id/statsRow"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="-14dp"
                android:background="@drawable/bg_glass"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tvTrip" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/lblTrip" style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="里程 km" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tvTime" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="骑行时间" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tvAvg" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="均速" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                    <TextView android:id="@+id/tvMax" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最高" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
