<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="110dp" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <!-- 顶部：状态 + 导航提示 -->
        <LinearLayout
            android:id="@+id/topArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/statusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tvGps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textAppearance="@style/StatusText" />

                <com.ebike.dash.SignalDotsView
                    android:id="@+id/gpsDots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:textAppearance="@style/StatusText" />

                <TextView
                    android:id="@+id/tvClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/StatusText" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右侧按钮 -->
        <LinearLayout
            android:id="@+id/fabColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="14dp"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="4dp">

            <ImageButton android:id="@+id/btnSearch" style="@style/RoundButton" android:src="@drawable/ic_search" android:contentDescription="搜索目的地" />
            <ImageButton android:id="@+id/btnRecenter" style="@style/RoundButton" android:src="@drawable/ic_my_location" android:contentDescription="回到当前位置" />
            <ImageButton android:id="@+id/btnInfo" style="@style/RoundButton" android:src="@drawable/ic_bar_chart" android:contentDescription="骑行数据" />
            <ImageButton android:id="@+id/btnMusic" style="@style/RoundButton" android:src="@drawable/ic_music" android:contentDescription="音乐" />
            <ImageButton android:id="@+id/btnExplore" style="@style/RoundButton" android:src="@drawable/ic_sparkle" android:contentDescription="探索" />
            <ImageButton android:id="@+id/btnSettings" style="@style/RoundButton" android:src="@drawable/ic_settings" android:contentDescription="菜单" />
        </LinearLayout>

        <!-- 底部：骑行数据（可展开）+ 音乐 + 数字速度 -->
        <LinearLayout
            android:id="@+id/bottomArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- 骑行数据（导航时还有剩余距离 / 到达时间）：默认隐藏，点右侧“数据”按钮显示 -->
            <LinearLayout
                android:id="@+id/infoPanel"
                style="@style/Card"
                android:layout_width="316dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:paddingVertical="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/navSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="10dp"
                    android:visibility="gone">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvRemain" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvEtaMin" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="用时" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvEta" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="到达" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnStopNav"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle"
                        android:contentDescription="结束导航"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <View
                    android:id="@+id/navDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="12dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/statsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvTrip" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/lblTrip" style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="里程 km" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvTime" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="时间" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvAvg" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="均速" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvMax" style="@style/Stat.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView style="@style/Stat.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最高" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 迷你播放器：默认隐藏，点右侧“音乐”按钮显示 -->
            <include
                android:id="@+id/music"
                layout="@layout/view_music"
                android:visibility="gone" />

            <!-- 数字速度 -->
            <include
                android:id="@+id/speed"
                layout="@layout/view_speed" />
        </LinearLayout>
    </FrameLayout>

    <!-- 离线地图框选：框外压暗，底部卡片显示范围与大小 -->
    <FrameLayout
        android:id="@+id/selectOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.ebike.dash.SelectionFrameView
            android:id="@+id/selectFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/selectCard"
            style="@style/Card"
            android:layout_width="316dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvSelectTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="框选离线地图范围"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSelectInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvSelectHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:tag="label"
                android:text="拖动、缩放地图来调整框内的范围"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSelectCancel"
                    style="@style/PillButton"
                    android:layout_marginEnd="10dp"
                    android:text="取消" />

                <TextView
                    android:id="@+id/btnSelectOk"
                    style="@style/PillButton"
                    android:text="下载这个范围" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 玩法模式（点亮城市、骑行回放）：主界面淡出，底部一张卡片 -->
    <FrameLayout
        android:id="@+id/modeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 回放结尾的 Driver 字标 -->
        <ImageView
            android:id="@+id/modeLogo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:layout_marginBottom="120dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher_fg"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/modeCard"
            style="@style/Card"
            android:layout_width="316dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="28dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvModeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvModeBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tvModeSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:tag="label"
                android:textSize="13sp" />

            <com.ebike.dash.EnergyBarView
                android:id="@+id/modeBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModeLeft"
                    style="@style/PillButton"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/btnModeRight"
                    style="@style/PillButton" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- 夜骑仪表：全黑屏幕，只留巨大的速度和能量条；轻点两下退出 -->
    <FrameLayout
        android:id="@+id/nightDash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNightClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/StatusText"
                android:textColor="#80FFFFFF" />

            <TextView
                android:id="@+id/tvNightBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/StatusText"
                android:textColor="#80FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNightSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="168sp" />

            <TextView
                android:id="@+id/tvNightUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="km/h"
                android:textColor="#80FFFFFF"
                android:textSize="16sp" />

            <com.ebike.dash.EnergyBarView
                android:id="@+id/nightEnergy"
                android:layout_width="280dp"
                android:layout_height="8dp"
                android:layout_marginTop="36dp" />

            <TextView
                android:id="@+id/tvNightInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFeatureSettings="tnum"
                android:textColor="#80FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNightHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:text="轻点两下退出"
            android:textColor="#59FFFFFF"
            android:textSize="13sp" />
    </FrameLayout>
</FrameLayout>
