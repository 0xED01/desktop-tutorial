<?xml version="1.0" encoding="utf-8"?>
<!-- Debug 构建：testOnly=true。安装需要 `adb install -t`，并允许
     `adb shell dpm remove-active-admin` 撤销 Device Owner。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:testOnly="true"
        tools:replace="android:testOnly">
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.yuandian.nightprotocol.debug.START_TEST" />
                <action android:name="com.yuandian.nightprotocol.debug.RECONCILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
